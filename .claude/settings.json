{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(composer ci:check)",
            "Bash(composer test)",
            "Bash(composer lint)",
            "Bash(php artisan test:*)",
            "Bash(php artisan route:list:*)",
            "Bash(php artisan migrate:status)",
            "Bash(vendor/bin/pint:*)",
            "Bash(npm run check:*)",
            "Bash(npm run types:check)",
            "Bash(npm run build)",
            "Bash(npx tsc --noEmit)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./data/**)",
            "Read(./**/*.zip)",
            "Read(./**/*.xlsx)",
            "Bash(git push --force:*)",
            "Bash(git push -f:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php \"$CLAUDE_PROJECT_DIR/scripts/ci-guard.php\" claude-hook"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && php .claude/hooks/format.php"
                    }
                ]
            }
        ]
    }
}
